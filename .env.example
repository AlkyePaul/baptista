# Baptista environment. Copy to .env.local and fill in. Never commit real values.

# --- Public (shipped to the browser) -----------------------------------------
# Only these two may be NEXT_PUBLIC. Use the *publishable* key (sb_publishable_...),
# never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Auth (required) ----------------------------------------------------------
# NextAuth session encryption secret (run `npx auth secret` to generate one).
AUTH_SECRET=
# Supabase project JWT secret (Settings → API in the dashboard). Used to mint
# authenticated JWTs so auth.uid() returns the correct user UUID.
SUPABASE_JWT_SECRET=

# --- Server-only --------------------------------------------------------------
# Supabase service-role key: admin operations (user lookup at login).
# SUPABASE_SECRET_KEY=
# Phase 04+: AI routing (docs/architecture/AGENT.md). Missing AI config never breaks the build.
# AI_GATEWAY_API_KEY=
# LOCAL_AI_BASE_URL=
# LOCAL_AI_API_KEY=
# LOCAL_AI_MODEL=
