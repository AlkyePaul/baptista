{
  "name": "baptista",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-zxing.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-zxing.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:db": "tsx --test \"supabase/tests/*.test.ts\"",
    "test:unit": "tsx --conditions=react-server --test \"lib/**/*.test.ts\" \"services/**/*.test.ts\"",
    "test": "npm run test:db && npm run test:unit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "barcode-detector": "3.2.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
